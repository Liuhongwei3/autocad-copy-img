<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      AutoCAD 2024 使用 net48。
      AutoCAD 2025 与 2026 使用 net8.0-windows；更新版本必须先确认其 .NET 运行时。
    -->
    <TargetFramework Condition="'$(AutoCADTargetFramework)' == ''">net48</TargetFramework>
    <TargetFramework Condition="'$(AutoCADTargetFramework)' != ''">$(AutoCADTargetFramework)</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AutoCADInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADInstallDir)\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADInstallDir)\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
